# Copy to api_keys.env and fill in your keys (never commit api_keys.env).
# research_tool.py loads these when env vars are unset.

XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional gateways
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local or remote Ollama (no key required if reachable)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# NVIDIA NIM (integrate.api.nvidia.com) — nvapi-... keys from build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=minimaxai/minimax-m3
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_MAX_TOKENS=8192
NVIDIA_NIM_TEMPERATURE=0.2
NVIDIA_NIM_TOP_P=0.95